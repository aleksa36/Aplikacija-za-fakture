# Kopirajte u .env (lokalno) ili unesite iste vrednosti u Netlify → Site configuration → Environment variables.

# Supabase: Connect → Connection string → "Transaction pooler" (port 6543).
# Ako se izostavi, lokalno se koristi ugrađena baza (PGlite) u folderu ./data.
DATABASE_URL=postgresql://postgres.PROJECT_REF:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Lozinka za ulazak u aplikaciju (na Netlify-ju je obavezna).
APP_PASSWORD=
