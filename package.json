{
  "name": "aplikacija-za-fakture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interna aplikacija za evidenciju sati, održavanja, fakture i izveštaje (Netlify + Supabase ili lokalno)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mantine/core": "8.3.18",
    "@mantine/dates": "8.3.18",
    "@mantine/form": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/modals": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.80.0",
    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "pdfmake": "0.2.23",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "serverless-http": "^3.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
